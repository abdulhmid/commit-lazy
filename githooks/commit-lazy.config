import os

# Commit Lazy Configuration

# Set LLM_ENDPOINT to use LLM-powered description refinement.
# Leave empty/comment to run without LLM (deterministic only).
LLM_ENDPOINT = os.getenv('LLM_ENDPOINT', '')

# Optional API key for the LLM proxy
LLM_API_KEY = os.getenv('LLM_API_KEY', '')

# Model used by the LLM (optional; 9router picks automatically if empty)
LLM_MODEL = os.getenv('LLM_MODEL', '')

# Set to True to force manual input for commit message type and description.
# Overrides LLM_ENDPOINT if set.
MANUAL_MODE = False