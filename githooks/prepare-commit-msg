#!/usr/bin/env python3
import sys, subprocess, json, os

msg_file = sys.argv[1]

# 1. Get staged file list
staged_files = subprocess.check_output(['git', 'diff', '--cached', '--name-only']).decode().strip().split('\n')
if staged_files == ['']: staged_files = []

# 2. Get diff
try:
    diff_output = subprocess.check_output(['git', 'diff', '--cached']).decode()
except Exception:
    diff_output = ""

# 3. Build context: file names + diff content
context = f"Staged files: {', '.join(staged_files)}\n\nDiff:\n{diff_output}" if staged_files else diff_output

# 4. Call LLM (9router proxy)
endpoint = os.getenv('LLM_ENDPOINT')
api_key = os.getenv('LLM_API_KEY')
fallback = f"feat: update {', '.join(staged_files) if staged_files else 'files'}"

if not endpoint:
    with open(msg_file, "w") as f:
        f.write(fallback)
    sys.exit(0)

payload = {
    "messages": [
        {"role": "system", "content": "You generate Conventional Commit messages. Analyze the given diff and choose the most appropriate type from: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert. Output ONLY a single line in format '<type>: <description>' (max 72 chars, no quotes, no explanation)."},
        {"role": "user", "content": context or "No diff (empty commit)"}
    ]
}

curl_cmd = ["curl", "-s", "-X", "POST", endpoint,
            "-H", "Content-Type: application/json"]
if api_key:
    curl_cmd += ["-H", f"Authorization: Bearer {api_key}"]
curl_cmd += ["-d", json.dumps(payload)]

result = subprocess.run(curl_cmd, capture_output=True, text=True)
commit_msg = fallback
if result.returncode == 0:
    try:
        resp = json.loads(result.stdout)
        commit_msg = resp.get('choices', [{'message': {'content': ''}}])[0]['message']['content'].strip()
        import re
        pattern = r"^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(?:\(.+\))?: .{1,72}$"
        if not re.match(pattern, commit_msg):
            commit_msg = fallback
    except Exception:
        commit_msg = fallback

# 5. Write message
with open(msg_file, "w") as f:
    f.write(commit_msg)
