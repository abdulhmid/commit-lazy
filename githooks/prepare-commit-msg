#!/usr/bin/env python3
import sys, subprocess, json, os

msg_file = sys.argv[1]

# 1. Deteksi status file via git status --porcelain (akurat)
result = subprocess.check_output(['git', 'status', '--porcelain']).decode().strip().split('\n')
if result == ['']: result = []

new_files = [line[3:] for line in result if line.startswith('A ')]
modified_files = [line[3:] for line in result if line.startswith('M ') or line.startswith('AM ')]
deleted_files = [line[3:] for line in result if line.startswith('D ')]

# 2. Logika Deterministik untuk Tipe
if new_files and not modified_files and not deleted_files:
    commit_type = "feat"
    base_desc = f"add {', '.join(new_files)}"
elif deleted_files:
    commit_type = "refactor"
    base_desc = f"remove {', '.join(deleted_files)}"
elif modified_files:
    commit_type = "fix"
    base_desc = f"update {', '.join(modified_files)}"
else:
    commit_type = "chore"
    base_desc = "misc changes"

# 3. Kumpulkan diff untuk konteks
try:
    diff_output = subprocess.check_output(['git', 'diff', '--cached']).decode()
except Exception:
    diff_output = ""

# 4. LLM mempercantik deskripsi
endpoint = os.getenv('LLM_ENDPOINT')
api_key = os.getenv('LLM_API_KEY')
final_msg = f"{commit_type}: {base_desc}"

if endpoint:
    payload = {
        "messages": [
            {"role": "system", "content": f"You are a commit assistant. The commit type is fixed as '{commit_type}'. Based ONLY on the diff and staged filenames, rewrite a meaningful short description. Output ONLY the description (no type prefix, no quotes, max 60 chars)."},
            {"role": "user", "content": f"Staged files: {', '.join(new_files + modified_files + deleted_files)}\n\nDiff:\n{diff_output}"}
        ]
    }
    curl_cmd = ["curl", "-s", "-X", "POST", endpoint, "-H", "Content-Type: application/json"]
    if api_key: curl_cmd += ["-H", f"Authorization: Bearer {api_key}"]
    curl_cmd += ["-d", json.dumps(payload)]
    result = subprocess.run(curl_cmd, capture_output=True, text=True)
    if result.returncode == 0:
        try:
            resp = json.loads(result.stdout)
            refined_desc = resp.get('choices',[{'message':{'content':''}}])[0]['message']['content'].strip()
            if refined_desc:
                final_msg = f"{commit_type}: {refined_desc}"
        except: pass

# 5. Tulis pesan
with open(msg_file, "w") as f:
    f.write(final_msg)