#!/usr/bin/env python3
import sys, subprocess, json, os

msg_file = sys.argv[1]

# Load configuration from commit-lazy.config
config = {
    'LLM_ENDPOINT': '',
    'LLM_API_KEY': '',
    'LLM_MODEL': 'gpt-3.5-turbo',
    'MANUAL_MODE': False
}
config_path = os.path.join(os.path.dirname(__file__), 'commit-lazy.config')
if os.path.exists(config_path):
    with open(config_path, 'r') as f:
        # Pass 'os' module to the exec environment
        exec(f.read(), {'os': os}, config)

LLM_ENDPOINT = config.get('LLM_ENDPOINT', '')
LLM_API_KEY = config.get('LLM_API_KEY', '')
LLM_MODEL = config.get('LLM_MODEL', 'gpt-3.5-turbo')
MANUAL_MODE = config.get('MANUAL_MODE', False)

# --- MANUAL MODE ---
if MANUAL_MODE:
    commit_types = {
        "1": "feat", "2": "fix", "3": "docs", "4": "chore", "5": "refactor", "6": "test",
        "7": "style", "8": "build", "9": "ci", "10": "perf", "11": "revert"
    }
    
    print("\nPilih tipe commit:")
    for key, value in commit_types.items():
        print(f"{key}: {value}")
    
    type_choice = input("Nomor (1-11): ")
    commit_type = commit_types.get(type_choice, "chore")
    
    description = input("Deskripsi singkat: ")
    final_msg = f"{commit_type}: {description}"

    with open(msg_file, "w") as f:
        f.write(final_msg)
    sys.exit(0)

# --- AUTO MODE ---
result = subprocess.check_output(['git', 'status', '--porcelain']).decode().strip().split('\n')
if result == ['']: result = []

new_files = [line[3:] for line in result if line.startswith('A ')]
modified_files = [line[3:] for line in result if line.startswith('M ') or line.startswith('AM ')]
deleted_files = [line[3:] for line in result if line.startswith('D ')]

if new_files and not modified_files and not deleted_files:
    commit_type = "feat"
    base_desc = f"add {', '.join(new_files)}"
elif deleted_files and not new_files and not modified_files:
    commit_type = "refactor"
    base_desc = f"remove {', '.join(deleted_files)}"
elif modified_files:
    commit_type = "fix"
    base_desc = f"update {', '.join(modified_files + deleted_files)}"
elif new_files and (modified_files or deleted_files):
    commit_type = "feat"
    base_desc = f"add {', '.join(new_files)}, update {', '.join(modified_files + deleted_files)}"
else:
    commit_type = "chore"
    base_desc = "misc changes"

try:
    diff_output = subprocess.check_output(['git', 'diff', '--cached']).decode()
except Exception:
    diff_output = ""

final_msg = f"{commit_type}: {base_desc}"

if LLM_ENDPOINT:
    payload = {
        "messages": [
            {"role": "system", "content": f"You are a commit assistant. The commit type is fixed as '{commit_type}'. Based ONLY on the diff and staged filenames, rewrite a meaningful short description. Output ONLY the description (no type prefix, no quotes, max 60 chars)."},
            {"role": "user", "content": f"Staged files: {', '.join(new_files + modified_files + deleted_files)}\n\nDiff:\n{diff_output}"}
        ]
    }
    if LLM_MODEL: payload["model"] = LLM_MODEL

    curl_cmd = ["curl", "-s", "-X", "POST", LLM_ENDPOINT, "-H", "Content-Type: application/json"]
    if LLM_API_KEY: curl_cmd += ["-H", f"Authorization: Bearer {LLM_API_KEY}"]
    curl_cmd += ["-d", json.dumps(payload)]
    
    result = subprocess.run(curl_cmd, capture_output=True, text=True)
    if result.returncode == 0:
        try:
            resp = json.loads(result.stdout)
            refined_desc = resp.get('choices',[{'message':{'content':''}}])[0]['message']['content'].strip()
            if refined_desc: final_msg = f"{commit_type}: {refined_desc}"
        except: pass

with open(msg_file, "w") as f:
    f.write(final_msg)
