#!/usr/bin/env python3
import sys, subprocess, json, os

msg_file = sys.argv[1]

# 1. Identifikasi status file
staged_files = subprocess.check_output(['git', 'diff', '--cached', '--name-only']).decode().strip().split('\n')
if staged_files == ['']: staged_files = []

# Cek file baru (untracked) vs modified
new_files = [f for f in staged_files if subprocess.run(['git', 'ls-files', '--error-unmatch', f], capture_output=True).returncode != 0]
modified_files = [f for f in staged_files if f not in new_files]

# 2. Logika Deterministik untuk Tipe
if new_files:
    commit_type = "feat"
    base_desc = f"add {', '.join(new_files)}"
elif modified_files:
    commit_type = "fix" # Default, akan dipercantik LLM
    base_desc = f"update {', '.join(modified_files)}"
else:
    commit_type = "chore"
    base_desc = "misc changes"

# 3. Minta LLM mempercantik deskripsi (opsional)
endpoint = os.getenv('LLM_ENDPOINT')
api_key = os.getenv('LLM_API_KEY')
final_msg = f"{commit_type}: {base_desc}"

if endpoint:
    diff_output = subprocess.check_output(['git', 'diff', '--cached']).decode()
    payload = {
        "messages": [
            {"role": "system", "content": f"You are a commit assistant. The commit type is fixed as '{commit_type}'. Rewrite the following description to be more meaningful based on the provided diff. Output ONLY the description text (no type prefix, max 60 chars)."},
            {"role": "user", "content": f"Original: {base_desc}\nDiff:\n{diff_output}"}
        ]
    }
    curl_cmd = ["curl", "-s", "-X", "POST", endpoint, "-H", "Content-Type: application/json"]
    if api_key: curl_cmd += ["-H", f"Authorization: Bearer {api_key}"]
    curl_cmd += ["-d", json.dumps(payload)]
    
    result = subprocess.run(curl_cmd, capture_output=True, text=True)
    if result.returncode == 0:
        try:
            resp = json.loads(result.stdout)
            refined_desc = resp.get('choices',[{'message':{'content':''}}])[0]['message']['content'].strip()
            final_msg = f"{commit_type}: {refined_desc}"
        except: pass

with open(msg_file, "w") as f:
    f.write(final_msg)
